# Copy this file to .env and set the paths for your machine.
# Only machine-specific values live here; everything else is a constant in the justfile.

# Ghidra install dir — required by every `just ghidra-*` / `sync-ghidra` recipe.
# Must match the version pinned in ghidra.toml (the tools verify this and fail fast).
# The Ghidra *project* is vendored in-repo (vendor/ghidra); do NOT set GHIDRA_PROJECT_DIR
# / GHIDRA_PROJECT_NAME / GHIDRA_PROGRAM_NAME here — the justfile owns those.
GHIDRA_INSTALL_DIR=/path/to/ghidra_12.1.2_PUBLIC

# Original game binary — required by `just bootstrap-reccmp` and `just run` (the
# parent directory must be a full install with Data/).
# Use an immutable copy of the original executable that matches reccmp-project.yml,
# not a mutable game-install path used for recomp smoke tests.
ORIGINAL_BINARY="orig/Imperialism.exe"

# Mac retail root or extracted CodeWarrior dump dir — optional. A retail root may
# contain IMPERIALISM01.iso and dump/Imperialism.datafork; an extracted resource
# directory may contain *.rsrc.bin files. Only needed to REGENERATE the vendored
# evidence (`just mac-evidence` or `just mac-resource-evidence`).
# MACOS_IMPERIALISM_DUMP=/path/to/mac-retail-root

# ONLY for a git worktree under a dot-directory (e.g. .claude/worktrees/<name>):
# Ghidra rejects project paths with dot segments, so point the live project at a
# dot-free dir before `just restore-project`. Do NOT set this on a normal checkout.
# GHIDRA_PROJECT_DIR=/path/to/ghidra-worktree-projects/<name>
