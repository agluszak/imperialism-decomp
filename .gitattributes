# Vendored Ghidra program archive (authoritative, portable form of the project DB).
# The live working project (vendor/ghidra/*.rep, *.gpr) is gitignored and recreated
# from this archive via `just restore-project`.
vendor/ghidra/exports/*.gzf filter=lfs diff=lfs merge=lfs -text
vendor/msvc500/lib/*.lib filter=lfs diff=lfs merge=lfs -text

# These are generated as one unit. The local driver keeps a valid side during
# integration, then tracked hooks rebuild and regenerate both files for review.
config/baselines/reccmp_progress_baseline.json merge=reccmp-baseline
config/baselines/reccmp_progress_baseline.functions.csv merge=reccmp-baseline
