# Copy this file to .env and set the paths for your machine.
# Only machine-specific values live here; everything else is a constant in the justfile.

# Ghidra install dir — required by every `just ghidra-*` / `sync-ghidra` recipe.
# Must match the version pinned in ghidra.toml (the tools verify this and fail fast).
# The Ghidra *project* is vendored in-repo (vendor/ghidra); do NOT set GHIDRA_PROJECT_DIR
# / GHIDRA_PROJECT_NAME / GHIDRA_PROGRAM_NAME here — the justfile owns those.
GHIDRA_INSTALL_DIR=/path/to/ghidra_12.1.2_PUBLIC

# Original game binary — required only by `just bootstrap-reccmp`.
ORIGINAL_BINARY="orig/Imperialism.exe"

# Extracted macOS CodeWarrior dump dir (holds Imperialism.datafork) — optional.
# Only needed to REGENERATE the vendored Mac evidence (`just import-macos-pef`).
# MACOS_IMPERIALISM_DUMP=/path/to/macos_dump
