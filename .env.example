# Copy this file to .env and adjust paths for your machine.

# Core target/build knobs
TARGET=IMPERIALISM
BUILD_DIR=build-msvc500
DOCKER_IMAGE=imperialism-msvc500
CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=RelWithDebInfo -DIMPERIALISM_MATCH_FLAGS_CSV=/Oy-,/Ob1"

# Original binary (required by `just bootstrap-reccmp`)
ORIGINAL_BINARY="orig/Imperialism.exe"

# Ghidra sync inputs (required by `just sync-ghidra`)
GHIDRA_INSTALL_DIR=/path/to/ghidra_12.1_PUBLIC
GHIDRA_PROJECT_DIR=/path/to/imperialism_knowledge
GHIDRA_PROJECT_NAME=imperialism-decomp
GHIDRA_PROGRAM_NAME=Imperialism.exe

# Class discovery defaults (used by `just class-discovery`)
CLASS_DISCOVERY_CLASSES="TGreatPower,TAutoGreatPower"
