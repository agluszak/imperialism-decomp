
# Editor/LSP navigation aid only — the real build is MSVC500 in Docker (see justfile).
# Diagnostics are fully suppressed: clang cannot parse the 1997 MFC headers this tree
# compiles against, so every diagnostic it produces here is noise (unknown_typename /
# undeclared_var_use cascades from unresolved <afx*.h> types). MSVC500 `just build` is
# the only authoritative compiler; clangd is kept for navigation/completion only.
CompileFlags:
  Add:
    - -Iinclude
    - -Isrc
    - -xc++
    - -std=c++98
    - -fms-extensions
    - -Wno-inconsistent-missing-override
    - -Wno-writable-strings
    - -Wno-dynamic-class-memaccess
  Compiler: clang++
Diagnostics:
  Suppress: '*'
